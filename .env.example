# Copy to .env and fill in. Never commit .env.
# Any of the first four missing -> that step runs in MOCK mode (UI shows a MOCK badge).

# Primary LLM: Nebius Token Factory (OpenAI-compatible), e.g.
#   NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
#   NEMOTRON_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEMOTRON_MODEL=

# Optional fallback LLM, used on error / timeout / 429 (NVIDIA API, OpenAI-compatible), e.g.
#   NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#   NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# Tavily search
TAVILY_API_KEY=

# Spending caps in USD
MAX_SESSION_COST_USD=2
MAX_TOTAL_COST_USD=10

# Price estimates used for the caps (optional; conservative defaults are 1 / 3 / 0.01).
# Replace with the real prices from Nebius and Tavily.
LLM_USD_PER_1M_INPUT_TOKENS=
LLM_USD_PER_1M_OUTPUT_TOKENS=
TAVILY_USD_PER_SEARCH=

# PORT=3000

# Demo cache of real verdicts in cache/claims.json (gitignored). Set to off to disable.
# DEMO_CACHE=off
